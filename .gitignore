# ============================================================
# MODEL DIRECTORIES
# ============================================================

# Ignore downloaded/generated model directories by default
models/
backend/models/
training/models/

# BUT KEEP MODEL DOCUMENTATION / CONFIGURATION
!models/
!models/**/

!models/**/README*
!models/**/LICENSE*
!models/**/config.json
!models/**/generation_config.json
!models/**/preprocessor_config.json
!models/**/tokenizer.json
!models/**/tokenizer_config.json
!models/**/special_tokens_map.json
!models/**/vocab.json
!models/**/merges.txt

# Same policy for backend models
!backend/models/
!backend/models/**/

!backend/models/**/README*
!backend/models/**/LICENSE*
!backend/models/**/config.json
!backend/models/**/generation_config.json
!backend/models/**/preprocessor_config.json
!backend/models/**/tokenizer.json
!backend/models/**/tokenizer_config.json
!backend/models/**/special_tokens_map.json
!backend/models/**/vocab.json
!backend/models/**/merges.txt

# Same policy for training models
!training/models/
!training/models/**/

!training/models/**/README*
!training/models/**/LICENSE*
!training/models/**/config.json
!training/models/**/generation_config.json
!training/models/**/preprocessor_config.json
!training/models/**/tokenizer.json
!training/models/**/tokenizer_config.json
!training/models/**/special_tokens_map.json
!training/models/**/vocab.json
!training/models/**/merges.txt


